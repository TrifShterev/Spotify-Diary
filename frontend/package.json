    "cy:run:component": "cypress run --component"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "cypress@16.1.1": true
  }
}
