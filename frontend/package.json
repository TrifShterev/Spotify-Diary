{
  "name": "spotify-diary-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Spotify Diary SPA (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cy:open": "cypress open --component",
    "cy:run:component": "cypress run --component",
    "cy:run:component:strict": "cypress run --component --expose pluginVisualRegressionCreateMissingImages=false",
    "cy:snapshots:update": "cypress run --component --expose pluginVisualRegressionUpdateImages=failures-only",
    "cy:snapshots:clean": "cypress run --component --expose pluginVisualRegressionCleanupUnusedImages=true"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/nunito": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pixsame/cypress-plugin-visual-regression-diff": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "cypress@16.1.1": true
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
