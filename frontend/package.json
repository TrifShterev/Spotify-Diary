{
  "name": "spotify-diary-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Spotify Diary SPA (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
